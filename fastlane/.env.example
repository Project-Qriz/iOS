# fastlane 환경변수 견본
#
# 사용법
#   1) 이 파일을 fastlane/.env 로 복사한다.   cp fastlane/.env.example fastlane/.env
#   2) 아래 값들을 실제 값으로 바꾼다.
#   3) fastlane beta / fastlane release 실행 시 .env 를 자동으로 읽는다.
#
# 주의
#   - fastlane/.env 와 *.p8 은 .gitignore 로 제외돼 있다. 절대 커밋하지 않는다.
#   - 이 견본 파일에는 실제 값을 적지 않는다.
#
# App Store Connect API 키 발급 방법
#   App Store Connect > 사용자 및 액세스 > 통합 > App Store Connect API > 팀 키
#   에서 "+" 로 키를 생성한다. 역할은 App Manager 이상이어야 한다.
#   .p8 파일은 생성 직후 한 번만 다운로드할 수 있으니 안전한 곳에 보관한다.

# API 키의 Key ID (10자리 영숫자). 키 목록의 "키 ID" 열에서 확인한다.
ASC_KEY_ID=XXXXXXXXXX

# 팀의 Issuer ID (UUID 형식). 키 목록 화면 상단의 "Issuer ID" 에서 확인한다.
# 같은 팀의 모든 키가 동일한 값을 쓴다.
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 다운로드한 .p8 개인 키 파일 경로. 프로젝트 루트(실행 위치) 기준 상대 경로이거나 절대 경로.
# 파일명은 AuthKey_<Key ID>.p8 형식이다.
ASC_KEY_PATH=fastlane/AuthKey_XXXXXXXXXX.p8
