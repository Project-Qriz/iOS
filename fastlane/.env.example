# cp fastlane/.env.example fastlane/.env 후 실제 값으로 교체 (.env와 *.p8은 커밋 금지)

# App Store Connect > 사용자 및 액세스 > 통합 > 팀 키의 "키 ID" (10자리)
ASC_KEY_ID=XXXXXXXXXX

# 같은 화면 상단의 Issuer ID (UUID)
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 다운로드한 .p8 파일 경로 (프로젝트 루트 기준)
ASC_KEY_PATH=fastlane/AuthKey_XXXXXXXXXX.p8
